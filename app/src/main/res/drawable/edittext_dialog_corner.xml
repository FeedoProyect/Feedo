<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Fondo del EditText -->
    <solid android:color="@color/color_fondoBuscadorDialog"/>

    <!-- Bordes redondeados -->
    <corners android:radius="16dp"/>

    <!-- Padding interno para que el texto no quede pegado a los bordes -->
    <padding
        android:left="16dp"
        android:top="12dp"
        android:right="16dp"
        android:bottom="12dp"/>

    <!-- Línea de borde (opcional pero recomendado) -->
    <stroke
        android:width="1dp"
        android:color="@color/color_hint_buscador"/>

</shape>