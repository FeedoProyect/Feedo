<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="@color/color_background_cardview">

    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Perfil"
        android:textStyle="bold"
        android:fontFamily="@font/balo_thambi"
        android:textSize="22sp"
        android:textColor="@color/text_de_items"
        android:layout_marginBottom="24dp" />


    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:paddingTop="4dp"
        android:paddingBottom="4dp"
        android:foregroundGravity="center"
        android:gravity="center">

        <!-- Imagen de perfil redonda (mismo tamaño que pediste) -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgProfile"
            android:layout_width="170dp"
            android:layout_height="175dp"
            android:layout_gravity="center"
            android:src="@drawable/agregarperfil"
            android:scaleType="centerCrop"
            android:clickable="true"
            android:focusable="true"
            app:shapeAppearanceOverlay="@style/CircularImagePerfil"
            app:strokeColor="@color/black"
            app:strokeWidth="2dp" />

        <!-- Loading centrado arriba de la imagen -->
        <ProgressBar
            android:id="@+id/progressBarFoto"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:indeterminate="true"
            android:visibility="gone"
            android:layout_gravity="center"/>
    </FrameLayout>

    <!-- Nombre -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Nombre"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@color/text_de_items"
        android:layout_marginBottom="8dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        android:layout_marginBottom="20dp"
        android:backgroundTint="@color/itemPersoPerfil">

        <EditText
            android:id="@+id/edtName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Escribe tu nombre"
            android:padding="12dp"
            android:textSize="14sp"
            android:textColor="@color/text_de_items"
            android:textColorHint="@color/dark_gray"
            android:background="@android:color/transparent"/>
    </androidx.cardview.widget.CardView>

    <!-- Biografía -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Biografía"
        android:textStyle="bold"
        android:textSize="14sp"
        android:textColor="@color/text_de_items"
        android:layout_marginBottom="8dp"/>

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="12dp"
        app:cardElevation="2dp"
        android:layout_marginBottom="32dp"
        android:backgroundTint="@color/itemPersoPerfil">

        <EditText
            android:id="@+id/edtBio"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Agregar biografía..."
            android:padding="12dp"
            android:gravity="top|start"
            android:textSize="14sp"
            android:textColor="@color/dark_gray"
            android:textColorHint="@color/dark_gray"
            android:background="@android:color/transparent"/>
    </androidx.cardview.widget.CardView>

    <!-- Botón Guardar -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp"
        android:backgroundTint="@color/tittle_color">

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="70dp"
            android:text="Listo"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:padding="14dp"
            android:background="@android:color/transparent"/>
    </androidx.cardview.widget.CardView>

</LinearLayout>



