<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    tools:visibility="visible">

    <TextView
        android:id="@+id/tvPosicionAddStep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:textColor="@color/text_de_items"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Paso 1" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/text_de_items"
        android:text="@string/textView_addPasos"
        android:textSize="19sp"
        android:textStyle="bold"
        android:layout_marginHorizontal="55dp"
        android:gravity="center"/>


    <EditText
        android:id="@+id/etDialogAddStep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/edittext_dialog_corner"
        android:layout_marginTop="15dp"
        android:textColor="@color/text_de_items"
        android:gravity="center_vertical"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="30dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonAddStep"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:padding="4dp"
            android:fontFamily="@font/balo_thambi"
            android:textColor="@color/white"
            android:textSize="22sp"
            app:backgroundTint="@color/tittle_color"
            app:cornerRadius="15dp"
            android:text="@string/botonDialog_add" />

    </LinearLayout>

</LinearLayout>