<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parentDialogTime"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    tools:visibility="visible">

    <TextView
        android:id="@+id/tvPosicionStep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        tools:text="Paso 1"
        android:layout_marginBottom="10dp"
        android:textSize="15sp"
        android:textColor="@color/text_de_items"
        android:textStyle="bold"/>

    <EditText
        android:id="@+id/etDialogAddTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/text_de_items"
        android:hint="@string/hintDialog_addStepItem"
        android:textColor="@color/text_de_items"
        android:textColorHint="@color/color_hint_buscador" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/botonDialogAddTime"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="40dp"
        android:fontFamily="@font/balo_thambi"
        android:text="@string/botonDialog_add"
        android:textColor="@color/white"
        android:textSize="22sp"
        app:backgroundTint="@color/tittle_color"
        app:cornerRadius="15dp" />

</LinearLayout>