<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/parentDialogTime"
    android:layout_width="300dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp"
    tools:visibility="visible">

    <TextView
        android:id="@+id/tvPosicionStep"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp"
        android:textColor="@color/text_de_items"
        android:textSize="15sp"
        android:textStyle="bold"
        tools:text="Paso 1" />

    <EditText
        android:id="@+id/etDialogEditStep"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:backgroundTint="@color/text_de_items"
        android:hint="@string/hintDialog_addStepItem"
        android:textColor="@color/text_de_items"
        android:textColorHint="@color/color_hint_buscador" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:weightSum="2">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonDialogEditStep"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:padding="4dp"
            android:fontFamily="@font/balo_thambi"
            android:textColor="@color/white"
            android:textSize="22sp"
            app:backgroundTint="@color/tittle_color"
            app:cornerRadius="15dp"
            android:text="@string/boton_guardarcambios" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/botonDialogEditDeleteStep"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:padding="4dp"
            android:fontFamily="@font/balo_thambi"
            android:textColor="@color/white"
            android:textSize="22sp"
            app:backgroundTint="@color/red"
            app:cornerRadius="15dp"
            android:text="@string/boton_dialogdeletestep" />

    </LinearLayout>

</LinearLayout>